# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y completa con tus valores

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your-bucket-name

# Secrets Manager
OPENAI_SECRET=your-secret-name
SECRET_NAME=your-api-secret-name

# OpenAI (alternativa si no usas Secrets Manager)
# OPENAI_API_KEY=sk-...

# Logging
LOG_LEVEL=INFO
